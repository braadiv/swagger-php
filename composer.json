{
  "name": "braadiv/swagger-php",
  "type": "library",
  "license": "Apache-2.0",
  "bin": [
    "bin/openapi"
  ],
  "description": "swagger-php - Generate interactive documentation for your RESTful API using phpdoc annotations (PHP 8.4 LTS Modernized Fork)",
  "keywords": [
    "json",
    "rest",
    "api",
    "service discovery",
    "php84"
  ],
  "homepage": "https://github.com/braadiv/swagger-php",
  "authors": [
    {
      "name": "Robert Allen",
      "email": "zircote@gmail.com"
    },
    {
      "name": "Bob Fanger",
      "email": "bfanger@gmail.com",
      "homepage": "https://bfanger.nl"
    },
    {
      "name": "Martin Rademacher",
      "email": "mano@radebatz.net",
      "homepage": "https://radebatz.net"
    },
    {
      "name": "Braa Salahi",
      "homepage": "https://github.com/braadiv",
      "role": "PHP 8.4 Modernization Maintainer"
    }
  ],
  "config": {
    "bin-dir": "bin",
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.1 || ^8.2 || ^8.3 || ^8.4",
    "ext-json": "*",
    "doctrine/annotations": "^1.7",
    "psr/log": "^1.1 || ^2.0 || ^3.0",
    "symfony/finder": "^2.2 || ^3.0 || ^4.0 || ^5.0 || ^6.0 || ^7.0",
    "symfony/yaml": "^3.3 || ^4.0 || ^5.0 || ^6.0 || ^7.0"
  },
  "autoload": {
    "psr-4": {
      "OpenApi\\": "src"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "replace": {
    "zircote/swagger-php": "self.version"
  }
}
